{
  "name": "agent-kit",
  "version": "0.1.0",
  "description": "Build and deploy agents as an ordinary project: prompt, config, env and setup as files. Runs on Hermes or OpenClaw.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/lazarkov/agent-kit.git"
  },
  "homepage": "https://github.com/lazarkov/agent-kit#readme",
  "bugs": {
    "url": "https://github.com/lazarkov/agent-kit/issues"
  },
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "bin": {
    "agent-kit": "dist/cli.js",
    "agent": "dist/cli.js"
  },
  "files": [
    "dist",
    "templates",
    "skills",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "check": "npm run typecheck && npm test",
    "prepublishOnly": "npm run build && npm test"
  },
  "keywords": [
    "agent",
    "agents",
    "hermes",
    "openclaw",
    "cli",
    "deploy",
    "agent-spaces"
  ],
  "devDependencies": {
    "@types/node": "^22.7.5",
    "typescript": "^5.6.3",
    "vitest": "^2.1.3"
  }
}
